function c(e,r){return`${e}-daily-${r}`}function i(e,r,l){try{const a=localStorage.getItem(c(e,r));if(!a)return null;const o=JSON.parse(a);if(!o||typeof o!="object"||Array.isArray(o))return null;const t=o;return t.v!==1||t.date!==r?null:l(t)}catch{return null}}function s(e,r,l){try{localStorage.setItem(c(e,r),JSON.stringify({...l,v:1,date:r}));const a=`${e}-daily-`,o=[];for(let t=0;t<localStorage.length;t+=1){const n=localStorage.key(t);n&&n.startsWith(a)&&n!==c(e,r)&&o.push(n)}for(const t of o)localStorage.removeItem(t)}catch{}}export{i as r,s as w};
