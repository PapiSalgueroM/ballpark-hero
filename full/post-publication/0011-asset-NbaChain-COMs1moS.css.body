._page_1x5jr_1{overflow-anchor:none}._timeline_1x5jr_2{height:240px;scroll-behavior:auto}._link_1x5jr_3{min-width:0;max-width:100%}._fullName_1x5jr_4{min-width:0;max-width:100%;overflow-wrap:anywhere}._action_1x5jr_5{min-height:44px}._action_1x5jr_5:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:3px}._latest_1x5jr_7{animation:_nbaChainLink_1x5jr_1 .42s ease-out 1}._connection_1x5jr_8{animation:_nbaChainConnection_1x5jr_1 .36s ease-out 1}@keyframes _nbaChainLink_1x5jr_1{0%{opacity:.45;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}@keyframes _nbaChainConnection_1x5jr_1{0%{opacity:.35}to{opacity:1}}@media (prefers-reduced-motion: reduce){._latest_1x5jr_7,._connection_1x5jr_8{animation:none}}
