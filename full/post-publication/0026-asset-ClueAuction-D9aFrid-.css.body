._feedbackArea_uu5ai_1{min-height:40px;margin-bottom:8px;font-size:12px;line-height:20px;overflow-wrap:anywhere}._suggestion_uu5ai_9,._receipt_uu5ai_9,._result_uu5ai_9{overflow-wrap:anywhere}._receipt_uu5ai_9{max-width:100%}[data-auction-clue]:focus-visible,._result_uu5ai_9 h2:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:3px}._reveal_uu5ai_23{animation:_clueReveal_uu5ai_1 .42s ease-out 1}._miss_uu5ai_27{animation:_guessMiss_uu5ai_1 .36s ease-out 1}._resultCue_uu5ai_31{animation:_caseResult_uu5ai_1 .42s ease-out 1}@media (max-width: 639px){._resultReceipt_uu5ai_36{display:grid;grid-template-columns:20px minmax(0,1fr) auto;row-gap:4px}._resultReceipt_uu5ai_36>span:first-child{grid-column:1;grid-row:1}._resultReceipt_uu5ai_36>span:nth-child(2){grid-column:2;grid-row:1;width:auto}._resultReceipt_uu5ai_36>span:nth-child(3){grid-column:1 / -1;grid-row:2}._resultReceipt_uu5ai_36>span:nth-child(4){grid-column:3;grid-row:1}}@keyframes _clueReveal_uu5ai_1{0%{box-shadow:0 0 0 3px hsl(var(--correct) / .5)}to{box-shadow:0 0 0 0 transparent}}@keyframes _guessMiss_uu5ai_1{0%{background-color:hsl(var(--destructive) / .28)}to{background-color:hsl(var(--destructive) / .1)}}@keyframes _caseResult_uu5ai_1{0%{box-shadow:0 0 0 3px hsl(var(--primary) / .5)}to{box-shadow:0 0 0 0 transparent}}@media (prefers-reduced-motion: reduce){._reveal_uu5ai_23,._miss_uu5ai_27,._resultCue_uu5ai_31{animation:none}}
