._board_19haj_1{overflow-anchor:none}._fullText_19haj_2{overflow-wrap:anywhere}._feedback_19haj_3{min-height:88px;margin-top:16px;border-radius:12px;padding:12px;border:1px solid hsl(var(--border))}._correct_19haj_4{--iq-tone: var(--primary);border-color:hsl(var(--primary) / .6);background:hsl(var(--primary) / .08)}._wrong_19haj_5{--iq-tone: var(--destructive);border-color:hsl(var(--destructive) / .55);background:hsl(var(--destructive) / .06)}._reveal_19haj_6{animation:_answerReveal_19haj_1 .42s ease-out 1}@keyframes _answerReveal_19haj_1{0%{opacity:.65;box-shadow:0 0 0 3px hsl(var(--iq-tone) / .35)}to{opacity:1;box-shadow:0 0 0 3px transparent}}@media (prefers-reduced-motion: reduce){._reveal_19haj_6{animation:none}._board_19haj_1 ._option_19haj_13{transition:none}}
