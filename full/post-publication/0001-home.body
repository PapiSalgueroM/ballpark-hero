<style>
	#lovable-badge {
		--badge-bg: #1b1b1b;
		--badge-text: #c5c1b9;
		--badge-text-hover: #dcdad5;
		--badge-radius: 6px;
		--badge-padding: 8px;
		--badge-gap: 6px;
		--badge-shadow: 
			0 0 0 1px rgba(0, 0, 0, 0.88),
			0 1px 0 0 rgba(0, 0, 0, 0.04),
			0 2px 2px -1px rgba(0, 0, 0, 0.08),
			0 4px 4px -2px rgba(0, 0, 0, 0.08),
			0 8px 8px -4px rgba(0, 0, 0, 0.08),
			0 16px 16px -8px rgba(0, 0, 0, 0.08);
		--badge-transition-duration: 0.2s;
		--badge-transition-easing: cubic-bezier(0.16, 1, 0.32, 1);
		--focus-color: #575ECF;
		--focus-offset: 2px;
		--focus-width: 2px;
		
		position: fixed;
		bottom: 12px;
		right: 12px;
		height: 24px;
		display: flex;
		align-items: center;
		z-index: 1000000;
		background-color: var(--badge-bg) !important;
		color: var(--badge-text) !important;
		border-radius: var(--badge-radius);
		box-shadow: var(--badge-shadow) !important;
		font-size: 12px;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		font-weight: 400 !important;
		text-transform: none !important;
		font-feature-settings: normal !important;
		transform: translateZ(0);
		will-change: transform, opacity;
		transition: opacity var(--badge-transition-duration) var(--badge-transition-easing);
	}

	#lovable-badge.closing {
		opacity: 0;
		pointer-events: none;
	}

	#lovable-badge-cta {
		display: flex;
		align-items: baseline;
		gap: var(--badge-gap);
		box-sizing: border-box;
		padding: 4px var(--badge-padding) 0;
		height: 100%;
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
		border-radius: var(--badge-radius) 0 0 var(--badge-radius);
		transition: 
			background-color var(--badge-transition-duration) ease,
			color var(--badge-transition-duration) ease,
			transform 0.1s ease;
	}

	#lovable-badge-cta:hover {
		background: rgba(255, 255, 255, 0.04);
		color: var(--badge-text-hover);
	}

	#lovable-badge-cta:active {
		transform: scale(0.98);
	}

	#lovable-badge-cta:focus {
		outline: none;
	}

	#lovable-badge-cta:focus-visible {
		outline: var(--focus-width) solid var(--focus-color);
		outline-offset: var(--focus-offset);
		z-index: 1;
	}

	#lovable-badge-text {
		line-height: 1;
	}

	/* The wordmark baseline sits at y=12 of the 16px logo; an empty 12px box
	   makes that the flex baseline so the text aligns to it on any system font. */
	#lovable-badge-logo {
		position: relative;
		display: block;
		width: 52px;
		height: 12px;
	}

	#lovable-badge-logo svg {
		position: absolute;
		top: 0;
		left: 0;
	}

	#lovable-badge-divider {
		width: 1px;
		height: 24px;
		background-color: rgba(255, 255, 255, 0.04);
		flex-shrink: 0;
	}

	#lovable-badge-close {
		width: 24px;
		height: 24px;
		min-width: 24px;
		min-height: 24px;
		cursor: pointer;
		background: none;
		border: none;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0 var(--badge-radius) var(--badge-radius) 0;
		flex-shrink: 0;
		transition: 
			background-color var(--badge-transition-duration) ease,
			transform 0.1s ease;
	}

	#lovable-badge-close:hover {
		background: rgba(255, 255, 255, 0.04);
	}

	#lovable-badge-close:active {
		transform: scale(0.92);
	}

	#lovable-badge-close:focus {
		outline: none;
	}

	#lovable-badge-close:focus-visible {
		outline: var(--focus-width) solid var(--focus-color);
		outline-offset: calc(var(--focus-offset) * -1);
		z-index: 1;
	}

	#lovable-badge-close svg path {
		fill: var(--badge-text);
		transition: fill var(--badge-transition-duration) ease;
	}

	#lovable-badge-close:hover svg path {
		fill: var(--badge-text-hover);
	}

	@media (prefers-reduced-motion: reduce) {
		#lovable-badge,
		#lovable-badge-cta,
		#lovable-badge-close,
		#lovable-badge-close svg path {
			transition: none;
		}
		
		#lovable-badge-cta:active,
		#lovable-badge-close:active {
			transform: none;
		}
	}

	@media (prefers-contrast: high) {
		#lovable-badge {
			--badge-bg: #000;
			--badge-text: #fff;
			--badge-text-hover: #fff;
			border: 2px solid currentColor;
		}
		
		#lovable-badge-cta:focus-visible,
		#lovable-badge-close:focus-visible {
			outline-width: 3px;
		}
	}
</style>
<script defer src="/~flock.js" data-proxy-url="/~api/analytics"></script><script defer src="/__l5e/events.270c78a44fc53e7b.js" data-artifact-kind="dwl_content_hash" data-artifact-id="7c5d1f7654e3f216a9d7ab9ec49ff8932da70a0d3dc689dd1cdb87296d6298e3" data-commit-sha="931308159c967c3ab9af404ed01e0b8483f90bd7" data-context-token="v1..gfV4AyYIxXsWe_9Bay5DhKvzXImeplcEgLPYR2CPk6E"></script></head>
  <body>
    <!--
      Round 257: the home page's static content.

      Every other page on this site is prerendered to a real document after
      the build (scripts/prerender.mjs) so a crawler can read it without
      running JavaScript. The home page cannot be done that way: vite
      generates dist/index.html from THIS file on whatever machine builds
      the site, so a snapshot written over it would be thrown away, and a
      snapshot written into public/ would collide with it. Measured on
      2026-08-21, before this block existed, the built home page carried
      exactly 43 characters of readable text: its own title. The most
      important page on the site was the emptiest.

      So the home page carries its content here, in the template, and React
      replaces the whole of #root the moment it mounts. A visitor sees this
      for the instant before the app draws, which is the same thing that
      happens on every prerendered route.

      RULES FOR EDITING THIS BLOCK. Nothing in it may be a figure that goes
      stale: the game counts are phrased as FLOORS ("120+") rather
      than exact numbers, because the exact ones change most weeks and the
      live ticker computes them anyway. Every link here is a real route in
      src/App.tsx. No data, no dates, no results.

      Round 260: the first version of this block said "more than 120" and
      "nearly forty" soccer games, both read off a crude grep of the registry
      file rather than off the registry itself. The real figures are 113 and
      30, so both claims were live and wrong for a day. scripts/simHomeCopy
      .mjs now reads every number in this block and checks it against the
      registry the site actually renders from, and it fails if a floor has
      been overtaken as well as if one is too high, because a floor that is
      forty games behind reality is not much better than one that is ahead.
   
      Round 280: this block was measured against the rest of the site and it
      was losing. Every submitted page carries between four and six thousand
      readable characters; this one carried 2,187, which made the page a
      crawler visits most often, and the page an ad reviewer opens first, the
      thinnest important document on the site. Twelve sports were named in a
      closing paragraph with not one link on any of them, so the three
      sections with no hub page of their own had no path in from here at all.
      The block below is longer for those two reasons and no other: it links
      what was already named, and it answers in writing the questions a first
      time visitor actually arrives with. Same rules as ever apply to every
      word of it, floors not figures and real routes only.

      Round 840: Google indexes the page AFTER it renders, and React threw all
      of this away on mount, so the rendered home page said almost nothing
      about the site. The words now live in src/data/homeCopy.ts, the React
      home draws them below the game tiles, and the block between the
      home-copy markers below is generated from the same module by
      node scripts/genHomeCopy.mjs. Edit the module, run the generator, commit
      both. scripts/simHomeCopy.mjs section 6 fails while the two disagree.
    -->
    <div id="root">
      <div id="dukb-boot" aria-hidden="true"><img src="/logo-mark.svg" alt="" width="72" height="72" decoding="async"></div>
      <div id="dukb-home-copy">
      <!-- home-copy:start. Generated from src/data/homeCopy.ts by node scripts/genHomeCopy.mjs: edit the module, never this block -->
      <h1>Free sports games</h1>
      <p>130+ free sports games in the browser: sports trivia, daily quizzes, grid puzzles and career sims. Every game plays without an account, nothing to download or install. New games and content ship almost every week, and the daily quizzes and puzzles reset for everyone at the same time, so you and everyone else get the same board.</p>
      <h2>Free sports career sims and soccer management games</h2>
      <p>Play a whole career out season by season: contracts, transfers, injuries, international call-ups, the lot.</p>
      <ul>
        <li><a href="/soccer-career">Soccer Career</a>, the biggest one here: start at 16 and play until you hang them up</li>
        <li><a href="/club-manager">Club Manager</a>, run a club, shape the squad and balance the budget</li>
        <li><a href="/nba-my-career">NBA My Career</a> and <a href="/nfl-my-career">NFL My Career</a>, create a prospect and play from draft night to retirement</li>
        <li><a href="/fight-career">Fight Career</a>, create a boxer, choose your fights and manage damage that never heals</li>
        <li><a href="/stadium-tycoon">Stadium Tycoon</a>, <a href="/hall-of-champions">Hall of Champions</a> and <a href="/wonderkid-factory">Wonderkid Factory</a>, the idle ones, the last an academy where you grow made up kids and sell at the right moment</li>
        <li><a href="/build-your-xi">Build Your XI</a>, pick a lineup and get it rated</li>
      </ul>
      <h2>Daily sports puzzles and grid games</h2>
      <p>The front page leads with one daily puzzle picked for everybody, a different one every day, and the rest of the daily boards sit in a row beside it. A few to start with:</p>
      <ul>
        <li><a href="/soccer-grid">Soccer Grid</a>, a three by three of clubs and countries</li>
        <li><a href="/college-grid">College Grid</a>, the same idea for college football</li>
        <li><a href="/transfer-path">Transfer Path</a>, get from one player to another through real moves</li>
        <li><a href="/minefield">Minefield</a>, name as many as you dare before you hit a wrong one</li>
        <li><a href="/silverware-sort">Silverware Sort</a>, stack five teams by titles won</li>
        <li><a href="/champ-or-not">Champ or Not</a> and <a href="/whod-they-beat">Who'd They Beat?</a></li>
      </ul>
      <h2>Sports history: every champion by year</h2>
      <p>The champion tables our quizzes run on are open to read in <a href="/records">The Record Books</a>: champions and award winners, year by year, checked against the official record before anything was allowed to serve it. Where history is odd we keep it odd, so seasons that were never played are missing on purpose and stripped titles stay vacant with a note saying why.</p>
      <h2>Browse sports games by sport</h2>
      <ul>
        <li><a href="/soccer">Soccer games</a>, the deepest section here by a distance</li>
        <li><a href="/pro-basketball">Basketball games</a>, grids, career paths and the front office</li>
        <li><a href="/pro-football">Football games</a>, rarity scored grids and a full GM job</li>
        <li><a href="/baseball">Baseball games</a>, franchise grids and a career to Cooperstown</li>
        <li><a href="/hockey">Hockey games</a>, franchise grids and a hard cap sim</li>
        <li><a href="/college">College games</a>, CFB and CBB puzzles and two dynasty sims</li>
      </ul>
      <h2>Sports trivia leaderboard and record books</h2>
      <ul>
        <li><a href="/leaderboard">World Leaderboard</a>, total points across every game</li>
        <li><a href="/records">The Record Books</a>, every champion year by year</li>
      </ul>
      <h2>GM simulator games: front offices and dynasties</h2>
      <p>If you would rather build the team than be on it, four front office sims put you in the general manager's chair. Build a roster, negotiate trades, draft prospects and try to meet your owner's expectations over several seasons.</p>
      <ul>
        <li><a href="/nba-front-office">NBA Front Office</a> and <a href="/nhl-front-office">NHL Front Office</a>, manage contracts, make trades and build a playoff team</li>
        <li><a href="/mlb-front-office">MLB Front Office</a>, manage payroll against the tax line, trade players and chase a title</li>
        <li><a href="/front-office">NFL Front Office</a>, the pro football one: real rosters, the cap, trades and the draft</li>
        <li><a href="/cfb-dynasty">CFB Dynasty</a> and <a href="/cbb-dynasty">CBB Dynasty</a>, recruit high school and portal players, manage NIL and build a winning program</li>
      </ul>
      <h2>Sports trivia quizzes</h2>
      <ul>
        <li><a href="/sports-millionaire">Sports Millionaire</a>, fifteen questions and three lifelines</li>
        <li><a href="/quiz-board">Sports Quiz Board</a>, five categories from two hundred to a thousand, and a wrong answer costs you</li>
        <li><a href="/ball-iq">Ball IQ</a>, a scored test of how well you actually read the game</li>
        <li><a href="/who-am-i">Who Am I?</a>, clues drip out one at a time and the fewer you need the better</li>
        <li><a href="/guess-the-year">Guess The Year</a> and <a href="/teammates">Teammates</a></li>
        <li><a href="/rank-em">Rank 'Em</a>, put five in the right order with no second chances</li>
        <li><a href="/player-bingo">Player Bingo</a>, fill a line on a five by five board before three strikes</li>
      </ul>
      <h2>Every sport we cover, from soccer to F1, tennis, golf and UFC</h2>
      <p>Soccer is the deepest section by a distance, with more than thirty games of its own, and the other twelve sections below all carry their own puzzles rather than a reskin of the soccer ones. Where a sport has a hub page it is linked here; where it does not, the game itself is.</p>
      <ul>
        <li><a href="/soccer">Soccer</a>, grids, transfer chains, career and management sims</li>
        <li><a href="/pro-football">Pro football</a> and <a href="/college">college sports</a>, rarity scored grids, a GM job and two dynasty sims</li>
        <li><a href="/pro-basketball">Pro basketball</a>, <a href="/baseball">baseball</a> and <a href="/hockey">hockey</a>, franchise grids, career paths and front offices</li>
        <li>Formula 1: <a href="/f1-driver">Guess the Driver</a>, <a href="/f1-constructor">Constructor</a> and <a href="/f1-higher-lower">Higher or Lower</a></li>
        <li>Tennis: <a href="/guess-tennis-player">Guess the Player</a>, <a href="/tennis-chain">Tennis Chain</a> and <a href="/tennis-higher-lower">Higher or Lower</a></li>
        <li>Golf: <a href="/guess-the-golfer">Guess the Golfer</a> and <a href="/golf-higher-lower">Higher or Lower</a></li>
        <li>Aussie rules: <a href="/aussie-rules-manager">Aussie Rules Manager</a>, a fictional club season, and <a href="/afl-higher-lower">AFL Higher or Lower</a></li>
        <li>NASCAR: <a href="/guess-nascar-driver">Guess the Driver</a> and <a href="/nascar-chain">NASCAR Chain</a></li>
        <li>Combat sports: <a href="/ufc">UFC quiz</a> and <a href="/ufc-chain">UFC Chain</a></li>
        <li>World and Olympic games: <a href="/olympics">Olympics</a>, <a href="/world-cup-bracket">World Cup Bracket</a> and <a href="/guess-the-nation">Guess the Nation</a></li>
      </ul>
      <h2>Sports trivia games: questions people ask before they start</h2>
      <h3>Are these sports games free to play?</h3>
      <p>Yes, all of them. There is nothing to unlock, no energy meter and no premium tier. Advertising can help cover hosting costs.</p>
      <h3>Do I need an account to play?</h3>
      <p>No. Everything plays signed out, your progress is kept in your own browser, and you appear on the <a href="/leaderboard">world leaderboard</a> without signing up for anything. An optional account keeps your scores on your profile. Career saves stay in this browser.</p>
      <h3>Can I play on my phone?</h3>
      <p>Yes. It is a website, not an app, so there is nothing to install and nothing to update. Every game is built to be played with a thumb first.</p>
      <h3>When do the daily sports puzzles reset?</h3>
      <p>At the same moment for everyone, so the board you get is the board everybody else gets that day. The career and management sims are not daily at all: they are long saves you come back to.</p>
      <h3>Where do the sports records and champion lists come from?</h3>
      <p>The champion tables are read out of <a href="/records">The Record Books</a>, checked against the official record before anything is allowed to use them. Seasons that were never played are missing on purpose and stripped titles stay vacant with a note saying why, because a quiz built on tidied up history teaches you the wrong thing.</p>
      <p><a href="/whats-new">See what shipped recently</a> · <a href="/about">About this site</a> · <a href="/contact">Contact</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
      <!-- home-copy:end -->
      </div>
    </div>
    <!--
      ROUND 282: THIS DOCUMENT IS ALSO THE 404 PAGE, AND UNTIL NOW IT NEVER SAID SO.

      The host answers every unknown address with this file and a 200, which is
      how a single page app is normally served. Measured on the live site as
      Googlebot on 2026-08-24: /this-page-does-not-exist-12345 came back 200 with
      18,725 bytes, the home page's title, the home page's readable copy, and no
      robots tag at all. Google has a name for that answer, a soft 404, and two
      complaints about it. One, it burns crawl budget on an unlimited number of
      addresses that do not exist, on a site whose real pages are already
      struggling to get looked at. Two, and worse since Round 257 put real copy
      into this template, every one of those addresses now serves a full copy of
      the home page, so the site is telling a crawler that infinitely many URLs
      are duplicates of its most important one.

      The app has rendered a proper noindexed 404 since Round 53, but that only
      exists after React mounts. This runs before it.

      HOW IT KNOWS, and it needs no list of routes to go stale. Every real
      address on this site is served from its own prerendered document, and every
      one of those carries id="dukb-snapshot" in its body. This template does not.
      So a document with no snapshot block, at any path other than the root, is
      by construction the fallback wearing the home page's clothes. A real route
      whose saved document somehow went missing would also be caught, and being
      noindexed is the safe direction for that: it is the same call Round 278
      made, and it turns a silent failure into a visible one.

      WHY THE CANONICAL HAS TO GO WITH IT. This template canonicalises to the
      home page, which on a dead address is a claim that the address IS the home
      page. Leaving that next to a noindex is the exact pairing Round 272 refused
      for the retired routes, because Google's guidance is that a noindex can
      propagate along a canonical to its target, and the target here is the most
      important page on the site.

      This script lives at the end of the body and therefore never reaches a
      snapshot, because the prerenderer rebuilds bodies out of readable content
      and drops everything else. That is exactly right: a real page must never
      run this.

      ROUND 284: IT MUST NOT RUN UNDER THE PRERENDERER EITHER, and the first
      time the prerenderer ran with this script in place it did. The prerender
      server hands every route this bare template on purpose, so that React
      can draw the real page into it. To this script that is indistinguishable
      from a dead address: no snapshot block, a path that is not the root. It
      fired on every route, and the noindex it wrote into the head went into
      all 133 saved documents, sitemap pages included. The prerenderer sets
      window.__DUKB_PRERENDER__ before any page code runs, and this returns
      on it. A real visitor never has that flag. simPrerender section 14 is the
      fence behind this: no document in the sitemap may ship a noindex.

      Guarded by scripts/playSoftFourOhFour.mjs, which checks the three cases
      that matter: a real route untouched, the home page untouched, and a dead
      address noindexed and stripped.
    -->
    <script>
      (function () {
        try {
          if (window.__DUKB_PRERENDER__) return;
          var path = location.pathname.replace(/\/+$/, '') || '/';
          if (path === '/') return;
          if (document.getElementById('dukb-snapshot')) return;

          var robots = document.createElement('meta');
          robots.setAttribute('name', 'robots');
          robots.setAttribute('content', 'noindex, follow');
          robots.setAttribute('data-dukb-fallback', '');
          document.head.appendChild(robots);

          var canonical = document.querySelector('link[rel="canonical"]');
          if (canonical) canonical.parentNode.removeChild(canonical);
          /* Defensive rather than load bearing: this template carries no og:url,
             and the harness therefore does not assert on it, because a check
             that cannot fire is worse than no check. It is here so that adding
             one later cannot quietly reintroduce a dead address claiming to be
             the home page. */
          var ogUrl = document.querySelector('meta[property="og:url"]');
          if (ogUrl) ogUrl.parentNode.removeChild(ogUrl);

          /* Round 650: a player profile (/profile/<name>) is a real page that
             can never have a saved copy, because nobody can prerender a
             username. It keeps the noindex and loses the home canonical above,
             which is what the profile page itself asks for once it loads, but
             it is not a dead address, so it must not be painted as one. Before
             this line every shared profile link opened on the 404 text. */
          if (/^\/profile\/[^/]+$/.test(path)) return;

          var NOT_FOUND_TITLE = 'Page Not Found | DoUKnowBall';
          var NOT_FOUND_DESC = 'There is no page at this address on DoUKnowBall. Browse the free sports games instead.';
          document.title = NOT_FOUND_TITLE;
          var desc = document.querySelector('meta[name="description"]');
          if (desc) desc.setAttribute('content', NOT_FOUND_DESC);
          /* og:title and og:description DO exist here and both say the home
             page's name, which on a dead address is the same false claim the
             canonical was making. */
          var ogTitle = document.querySelector('meta[property="og:title"]');
          if (ogTitle) ogTitle.setAttribute('content', NOT_FOUND_TITLE);
          var ogDesc = document.querySelector('meta[property="og:description"]');
          if (ogDesc) ogDesc.setAttribute('content', NOT_FOUND_DESC);

          var root = document.getElementById('root');
          if (root) {
            root.innerHTML =
              '<h1>404: there is no page at this address</h1>' +
              '<p>The link is either old or wrong. Everything on DoUKnowBall is free and needs no account, so try one of these instead.</p>' +
              '<ul>' +
              '<li><a href="/">All the games</a></li>' +
              '<li><a href="/soccer">Soccer games</a></li>' +
              '<li><a href="/pro-basketball">Basketball games</a></li>' +
              '<li><a href="/pro-football">Football games</a></li>' +
              '<li><a href="/baseball">Baseball games</a></li>' +
              '<li><a href="/hockey">Hockey games</a></li>' +
              '<li><a href="/college">College games</a></li>' +
              '<li><a href="/records">The Record Books</a></li>' +
              '</ul>';
          }
        } catch (e) { /* a broken 404 marker must never stop the app booting */ }
      })();
    </script>
  
