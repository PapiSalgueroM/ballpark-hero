  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Round 90: index.html must never be cached. The hashed asset files
         under /assets are immutable and still cache normally; only this
         document has to stay fresh so a returning player always gets the
         newest chunk names. -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>DoUKnowBall: Free Sports Trivia Games and Daily Quizzes</title>
    <!-- Round 69: static AdSense account association. The ad script itself stays
         consent gated below; this meta tag just makes the site-to-account link
         visible to Google's crawler on the raw HTML, no consent needed. -->
    <meta name="google-adsense-account" content="ca-pub-2929318086316376" />
    <meta name="msvalidate.01" content="9C0F485E90B6744EF88628240F61B9E1" />
    <meta name="yandex-verification" content="78b02f385cab3272" />
    <meta name="description" content="130+ free sports games, from a Soccer Career sim and Club Manager to daily trivia and quizzes for the NFL, NBA, MLB, NHL, F1, UFC and more. No login needed.">
    <!-- Round 265: the home page's canonical, in the template rather than in
         the app. Every OTHER page carries one because the prerenderer captures
         the head after React has drawn it, but the home page is deliberately
         not prerendered (the host regenerates it every build), so its canonical
         only existed once JavaScript ran. Measured on the live site with
         JavaScript off and a Googlebot user agent: ten pages checked, ten
         canonicals, and the one that was missing was the home page. It is also
         the page most likely to collect tracking parameters from shares, which
         is exactly what a self referencing canonical is for. -->
    <link rel="canonical" href="https://douknowball.com/">

    <!-- Round 281: who this site is, in the template rather than at runtime.

         Every other page ships as a snapshot whose head is copied verbatim from
         the build, so a tag React adds survives. The home page is the one page
         that cannot work that way, because vite regenerates it from THIS file on
         whatever machine builds the site, so anything added at runtime never
         reaches the raw HTML. Measured on 2026-08-24, the shipped home page
         carried zero structured data blocks: the WebApplication object the app
         has been generating since Round 53 had never been seen by a crawler,
         only by a browser that runs JavaScript. Same trap that swallowed the
         canonical in Round 265 and the readable copy in Round 257.

         WebSite and Organization are the two things Google reads to work out
         whose domain this is and what to call it, and WebApplication is what
         says the thing at this address is a free browser game rather than a
         shop or a blog. All three are claims about the SITE rather than about
         whichever page is being served, and each carries an @id naming the site
         root so none of them can be read as a claim about the current page.
         Putting them here does exactly that: the snapshots copy this head, so
         all 126 of them carry the pair and a crawler can tie 127 documents to
         one entity. The page level object, whatever type that page is, is still
         emitted by PageSeo on top of this.

         KEEP THIS IN STEP WITH SITE_JSON_LD in src/lib/pageSchema.ts.
         scripts/simSchema.mjs parses this block and compares it against that
         export, so the two cannot drift apart quietly. -->
    <script type="application/ld+json">[{"@context":"https://schema.org","@type":"WebSite","@id":"https://douknowball.com/#website","name":"DoUKnowBall","alternateName":"Do U Know Ball","url":"https://douknowball.com/","inLanguage":"en","publisher":{"@id":"https://douknowball.com/#org"}},{"@context":"https://schema.org","@type":"Organization","@id":"https://douknowball.com/#org","name":"DoUKnowBall","url":"https://douknowball.com/","logo":"https://douknowball.com/icon-512.png"},{"@context":"https://schema.org","@type":"WebApplication","@id":"https://douknowball.com/#webapp","name":"DoUKnowBall","url":"https://douknowball.com/","applicationCategory":"GameApplication","operatingSystem":"Web Browser","isAccessibleForFree":true,"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"publisher":{"@id":"https://douknowball.com/#org"}}]</script>
    
    
    <!-- Round 286: the site's own social image, on its own domain. The old
         one lived on the host's upload bucket, which is an external image host
         (the legal rule allows exactly one, flagcdn.com), said "10+ games" on a
         site with over a hundred, and had a line of garbled text at the bottom.
         It is generated from the same source as the favicon and the header
         mark: scripts/logo/gen_logo.py. -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://douknowball.com/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="DoUKnowBall: free daily sports trivia, puzzles and career sims">
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://douknowball.com/og-image.png">
    <!-- Round 286: icons. The SVG is the crisp one and modern browsers take it
         first; the .ico carries 16, 32 and 48 for everything else; the touch
         icon is what a phone shows when the site is added to a home screen. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <meta name="theme-color" content="#0b0d14">
    <!-- Round 290: installable. The manifest names the same icons the tab and the home
         screen already use, so Add to Home Screen on Android and desktop Chrome gets the
         mark, the name and a standalone window. simBrand section 7 holds the file to the
         icons on disk and this theme colour. -->
    <link rel="manifest" href="/manifest.json">
    <meta name="application-name" content="DoUKnowBall">
    <meta name="apple-mobile-web-app-title" content="DoUKnowBall">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
      // Owner 2026-08-05: no third-party editor badge should ever show on the
      // live site. The host injects a floating "Edit with ..." badge into the
      // published page after load; this watcher removes it (and anything like
      // it) the moment it appears.
      (function () {
        var isBadge = function (el) {
          if (!(el instanceof HTMLElement)) return false;
          var idc = ((el.id || '') + ' ' + (el.className || '')).toString().toLowerCase();
          if (idc.indexOf('lovable') !== -1 || idc.indexOf('gpt-engineer') !== -1 || idc.indexOf('gptengineer') !== -1) return true;
          if (el.tagName === 'A') {
            var href = (el.getAttribute('href') || '').toLowerCase();
            if (href.indexOf('lovable.dev') !== -1 || href.indexOf('gptengineer.app') !== -1) return true;
          }
          return false;
        };
        var sweep = function () {
          try {
            var all = document.querySelectorAll('[id*="lovable" i], [class*="lovable" i], a[href*="lovable.dev"], a[href*="gptengineer"], [id*="gpt-engineer" i]');
            for (var i = 0; i < all.length; i++) {
              var el = all[i];
              if (isBadge(el)) el.remove();
            }
          } catch (e) { /* never break the page over badge cleanup */ }
        };
        new MutationObserver(sweep).observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', sweep);
        window.addEventListener('load', sweep);
      })();
    </script>
