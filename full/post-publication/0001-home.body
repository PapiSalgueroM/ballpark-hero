    #dukb-boot img{width:72px;height:72px;animation:dukb-boot-pulse 1.2s ease-in-out infinite}
    @keyframes dukb-boot-pulse{0%,100%{opacity:.55;transform:scale(.96)}50%{opacity:1;transform:scale(1)}}
    @media (prefers-color-scheme:light){#dukb-boot{background:hsl(210 20% 98%)}}
    @media (prefers-reduced-motion:reduce){#dukb-boot img{animation:none}}
    #dukb-home-copy{max-height:100vh;overflow:hidden}
  </style>
