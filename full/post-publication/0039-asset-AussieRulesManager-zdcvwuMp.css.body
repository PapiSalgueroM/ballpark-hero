._board_czal3_1{display:grid;gap:12px;min-width:0}._board_czal3_1 h2{margin:0;font-size:20px;font-weight:800}._board_czal3_1 h3{margin:0 0 8px;font-size:16px;font-weight:700}._board_czal3_1 p{margin:0;font-size:13px;line-height:1.5}._board_czal3_1 strong,._board_czal3_1 span,._board_czal3_1 h2,._board_czal3_1 h3,._board_czal3_1 p{overflow-wrap:anywhere}._muted_czal3_6{color:hsl(var(--muted-foreground))}._heading_czal3_7{display:flex;align-items:center;justify-content:space-between;gap:10px}._heading_czal3_7>div{min-width:0}._heading_czal3_7>button{flex-shrink:0}._card_czal3_10{padding:14px;border:1px solid hsl(var(--border));border-radius:16px;background:hsl(var(--card));display:grid;gap:12px;min-width:0}._action_czal3_11,._secondary_czal3_11,._tile_czal3_11,._player_czal3_11{min-height:44px;border-radius:10px;padding:10px 12px;font-size:13px;font-weight:600;text-align:left}._action_czal3_11{background:hsl(var(--primary));color:hsl(var(--primary-foreground))}._secondary_czal3_11{background:hsl(var(--secondary));color:hsl(var(--foreground));border:1px solid hsl(var(--border))}._tile_czal3_11,._player_czal3_11{display:grid;gap:4px;background:hsl(var(--secondary));color:hsl(var(--foreground));border:1px solid hsl(var(--border))}._tile_czal3_11 span,._player_czal3_11 span{font-size:12px;font-weight:400;color:hsl(var(--muted-foreground))}._board_czal3_1 button:disabled{opacity:.55;cursor:default}._board_czal3_1 button:focus-visible,._board_czal3_1 select:focus-visible,._board_czal3_1 summary:focus-visible,._board_czal3_1 h2:focus{outline:2px solid hsl(var(--primary));outline-offset:3px}._clubs_czal3_18{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}._tabs_czal3_19{display:flex;gap:8px}._tabs_czal3_19 button{flex:1;text-align:center}._feedback_czal3_21{min-height:40px;font-size:12px;line-height:1.5;color:hsl(var(--primary))}._committed_czal3_22{display:block;animation:_committed_czal3_22 .42s ease-out both}._choices_czal3_23{display:grid;gap:8px}._actions_czal3_24{display:flex;gap:8px;flex-wrap:wrap}._actions_czal3_24 button{flex:1;text-align:center}._players_czal3_26{display:grid;gap:8px;max-height:320px;overflow-y:auto;padding:4px}._score_czal3_27{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;text-align:center}._score_czal3_27>div{display:grid;gap:6px}._score_czal3_27 strong{font-size:13px}._score_czal3_27 span{font-size:21px;font-weight:800}._swap_czal3_31{display:grid;gap:10px}._swap_czal3_31 label{display:grid;gap:5px;font-size:12px;font-weight:600;min-width:0}._swap_czal3_31 select{width:100%;min-width:0;min-height:44px;border:1px solid hsl(var(--border));border-radius:10px;padding:8px;background:hsl(var(--secondary));color:hsl(var(--foreground));font-size:12px}._events_czal3_34{min-width:0;font-size:12px}._events_czal3_34 summary{min-height:44px;padding:12px 0;cursor:pointer}._events_czal3_34 ol{max-height:180px;overflow-y:auto;padding-left:18px}._events_czal3_34 li{margin:5px 0;overflow-wrap:anywhere}._table_czal3_38{min-width:0;overflow-x:auto}._table_czal3_38 table{width:100%;border-collapse:collapse;font-size:11px}._table_czal3_38 th,._table_czal3_38 td{padding:9px 4px;text-align:center;border-bottom:1px solid hsl(var(--border))}._table_czal3_38 th:first-child{text-align:left;max-width:130px;overflow-wrap:anywhere}@keyframes _committed_czal3_22{0%{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}@media (prefers-reduced-motion: reduce){._committed_czal3_22{animation:none}}._stack_1ysdd_1{display:grid;gap:12px;min-width:0}._tierGroup_1ysdd_2{display:grid;gap:8px}._list_1ysdd_3{display:grid;gap:6px;padding:0;margin:0;list-style:none;font-size:12px;line-height:1.5}._list_1ysdd_3 li{padding:8px 10px;border:1px solid hsl(var(--border));border-radius:10px;background:hsl(var(--secondary));overflow-wrap:anywhere}._mine_1ysdd_5{outline:2px solid hsl(var(--primary));outline-offset:-2px}._cut_1ysdd_6 td,._cut_1ysdd_6 th{border-bottom:2px solid hsl(var(--primary))}._week_1ysdd_7{display:grid;gap:6px}._refusal_1ysdd_8{color:hsl(var(--destructive));font-weight:600}
