._board_t5n50_1{overflow-anchor:none}._fullText_t5n50_2{overflow-wrap:anywhere}._action_t5n50_3{min-height:44px;min-width:44px}._action_t5n50_3:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:3px}._reveal_t5n50_5{animation:_clueReveal_t5n50_1 .36s ease-out 1}._success_t5n50_6{animation:_solvedOutline_t5n50_1 .42s ease-out 1}._failure_t5n50_7{animation:_missedOutline_t5n50_1 .36s ease-out 1}@keyframes _clueReveal_t5n50_1{0%{opacity:.55}to{opacity:1}}@keyframes _solvedOutline_t5n50_1{0%{box-shadow:0 0 0 2px hsl(var(--primary) / .6)}to{box-shadow:0 0 0 2px transparent}}@keyframes _missedOutline_t5n50_1{0%{box-shadow:0 0 0 2px hsl(var(--destructive) / .55)}to{box-shadow:0 0 0 2px transparent}}@media (prefers-reduced-motion: reduce){._reveal_t5n50_5,._success_t5n50_6,._failure_t5n50_7{animation:none}}
