._panel_uwjty_1{min-width:0;overflow-anchor:none}._action_uwjty_6{min-height:44px}._choices_uwjty_8{max-height:176px;overflow-y:auto;overscroll-behavior:contain}._choice_uwjty_8{display:flex;align-items:center;gap:8px;min-height:44px;padding:4px}._choice_uwjty_8 input{flex-shrink:0}._name_uwjty_23{min-width:0;overflow-wrap:anywhere;font-size:12px}._choice_uwjty_8:focus-within,._action_uwjty_6:focus-visible,._receipt_uwjty_24:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:2px}._receipt_uwjty_24{min-height:40px;padding-top:8px;font-size:12px}._committed_uwjty_30{display:block;animation:_applied_uwjty_1 .42s ease-out 1}@keyframes _applied_uwjty_1{0%{opacity:.4}to{opacity:1}}@media (prefers-reduced-motion: reduce){._committed_uwjty_30{animation:none}}._status_17enp_1{position:fixed;z-index:100;top:calc(12px + env(safe-area-inset-top,0px));left:12px;right:12px;pointer-events:none}._receipt_17enp_10{pointer-events:auto;min-width:0;border:1px solid hsl(var(--primary) / .45);border-radius:12px;padding:12px;background:hsl(var(--card));box-shadow:0 8px 24px hsl(var(--foreground) / .16);color:hsl(var(--foreground));opacity:1;transform:none;overflow-anchor:none;animation:_waiverEnter_17enp_1 .42s ease-out 1}._heading_17enp_25{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}._heading_17enp_25>div{min-width:0}._dismiss_17enp_27{display:grid;place-items:center;flex-shrink:0;min-width:44px;min-height:44px;border:1px solid hsl(var(--border));border-radius:8px;font-size:20px}._dismiss_17enp_27:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:2px}._label_17enp_29{font-size:10px;color:hsl(var(--muted-foreground))}._player_17enp_30{margin-top:2px;font-size:13px;font-weight:700;overflow-wrap:anywhere}._stats_17enp_31{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin-top:8px}._stats_17enp_31>div{min-width:0}._stats_17enp_31 dt{font-size:10px;color:hsl(var(--muted-foreground))}._stats_17enp_31 dd{margin-top:2px;font-size:12px;overflow-wrap:anywhere}._value_17enp_35{display:inline-block;border-radius:3px;animation:_waiverValue_17enp_1 .42s ease-out 1}@media (min-width: 640px){._status_17enp_1{top:auto;left:auto;right:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));width:420px}}@keyframes _waiverEnter_17enp_1{0%{opacity:.65;transform:translateY(4px)}to{opacity:1;transform:none}}@keyframes _waiverValue_17enp_1{0%{background-color:hsl(var(--primary) / .25)}to{background-color:transparent}}@media (prefers-reduced-motion: reduce){._receipt_17enp_10,._value_17enp_35{animation:none;animation-duration:0s!important;opacity:1;transform:none}}
