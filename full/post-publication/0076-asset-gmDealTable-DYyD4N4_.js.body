const T=.97;function i(t,n){if(n<=0)return"agreed";const e=t/n;return e>=.97?"agreed":e>=.75?"counter":e>=.55?"insulted":"walkout"}function O(t,n){if(n<=0)return 100;const e=t/n;if(e>=.97)return 100;if(e<=.55)return 0;const o=.97-.55;return Math.round((e-.55)/o*100)}const f=4,I=1;function R(t){return t==="insulted"?2:t==="counter"?1:0}const c=.02;function s(t){let n=2166136261;for(let e=0;e<t.length;e++)n^=t.charCodeAt(e),n=Math.imul(n,16777619)>>>0;return n>>>0}function _(t,n,e){if(n<=c)return{low:t,high:t,spread:n,exact:!0};const o=s(e),a=o%1e3/1e3*n,u=(o>>>10)%1e3/1e3*n,r=Math.max(.1,Math.round(t*(1-a)*10)/10),A=Math.max(r,Math.round(t*(1+u)*10)/10);return{low:r,high:A,spread:n,exact:!1}}export{T as A,f as O,c as V,I as a,_ as b,O as d,s as h,i as o,R as p};
