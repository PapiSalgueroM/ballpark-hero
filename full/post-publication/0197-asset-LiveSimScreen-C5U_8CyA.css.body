.cm-stagebox{position:fixed;top:0;right:0;bottom:0;left:0;height:100vh;height:100dvh;z-index:55;overflow:hidden;box-sizing:border-box;padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}.cm-stagebox:after{content:"";position:fixed;top:0;right:0;bottom:0;left:0;z-index:-1;background-color:inherit}.cm-stage{position:relative;display:flex;flex-direction:column;width:100%;height:100%;min-height:0}.cm-stage-main{display:flex;flex-direction:column;flex:1 1 0%;min-width:0;min-height:0}.cm-strip{display:flex;flex-wrap:wrap;align-items:center;gap:2px 4px;padding:2px 4px;flex:0 0 auto}.cm-strip-comp{flex:1 1 0%;min-width:0;padding:0 4px;line-height:13px;max-height:39px;overflow:hidden;overflow-wrap:anywhere;text-wrap:balance}.cm-strip-score{order:5;flex:0 0 100%;display:flex;align-items:center;justify-content:center;gap:10px;min-width:0;height:32px}.cm-strip-leg{order:6;flex:0 0 100%;line-height:16px}.cm-pitchbox{position:relative;flex:1 1 0%;min-width:0;min-height:0;display:flex;align-items:center;justify-content:center;container-type:size;touch-action:none}.cm-pitchbox>.pm-surface{width:100%;height:100%;max-height:175cqw}.cm-dot-label{max-width:52px;max-width:min(52px,12cqw)}.cm-statline{display:flex;align-items:center;justify-content:space-around;gap:8px;height:22px;flex:0 0 auto;padding:0 4px;white-space:nowrap;overflow:hidden}.cm-eventline{height:24px;line-height:24px;flex:0 0 auto;padding:0 6px}.cm-controls{display:flex;gap:2px;height:48px;padding:2px 0;flex:0 0 auto}.cm-controls>button{flex:1 1 0%;min-width:0;height:44px}.cm-stage-side{position:absolute;left:0;right:0;bottom:48px;z-index:30;display:flex;flex-direction:column;gap:8px;min-height:0;max-height:70%;padding:10px;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;border-top:1px solid hsl(var(--border));border-radius:16px 16px 0 0;background:hsl(var(--background));box-shadow:0 -8px 24px #0006}.cm-stage-side[data-cm-live-side=none],.cm-side-log{display:none}.cm-stage-side:not([data-cm-live-side=stats]) [data-cm-live-stats]{display:none}.cm-stage-side [data-cm-live-stats] span{font-size:11px;line-height:1.3}@media (min-width:768px) and (min-height:500px){.cm-stage{display:grid;grid-template-columns:minmax(0,1fr) 360px;grid-template-rows:minmax(0,1fr);gap:12px;max-width:1120px;margin:0 auto;padding:12px;box-sizing:border-box}.cm-stage-main{gap:6px}.cm-strip{gap:4px 6px;padding:0}.cm-strip-stats{display:none}.cm-pitchbox>.pm-surface{border-radius:12px}.cm-statline{display:none}.cm-controls{gap:6px;height:56px;padding:6px 0}.cm-stage-side{position:static;max-height:none;padding:0;border-top:0;border-radius:0;box-shadow:none;background:none}.cm-stage-side[data-cm-live-side=none]{display:flex}.cm-stage-side[data-cm-live-side=none] .cm-side-log,.cm-stage-side[data-cm-live-side=stats] .cm-side-log,.cm-stage-side[data-cm-live-side=none] [data-cm-live-stats]{display:block}}@media (min-width:1024px) and (min-height:500px){.cm-strip{min-height:56px}.cm-strip-comp{flex:0 1 auto;max-width:200px;padding:0}.cm-strip-score{order:0;flex:1 1 0%;height:auto}.cm-pitchbox>.pm-surface{width:min(100cqw,75cqh);height:min(100cqh,calc(100cqw * 4 / 3));max-height:none}}@media (orientation:landscape) and (max-height:499px){.cm-stage-main{display:grid;grid-template-columns:minmax(0,1fr) 320px;grid-template-rows:auto auto auto minmax(0,1fr) auto;-moz-column-gap:6px;column-gap:6px}.cm-pitchbox{grid-column:1;grid-row:1 / -1}.cm-strip{grid-column:2;grid-row:1}.cm-statline{grid-column:2;grid-row:2}.cm-eventline{grid-column:2;grid-row:3}.cm-controls{grid-column:2;grid-row:5}.cm-pitchbox>.pm-surface{width:min(100cqw,calc(100cqh * 4 / 3));height:min(100cqh,75cqw);max-height:none}.cm-stage-side{left:auto;width:320px;max-height:calc(100% - 52px)}}
