    '  /* The wall lines up to protect the near post, on the side the keeper leans away from. */\n' +
    '  const centre = setup.keeperLean > 0 ? -0.34 : 0.34;\n' +
    '  return { lo: centre - width, hi: centre + width };\n' +
    '}\n' +
    '\n' +
    '/**\n' +
    ' * Score one kick. The single place the rules live, so the page, the harness\n' +
    ' * and any future mode all agree.\n' +
    ' */\n' +
    'export function takeShot(aim: Aim, setup: KickSetup, rng: () => number): ShotResult {\n' +
    '  const spray = sprayFor(aim, setup, rng);\n' +
    '  const path = flightPath(aim, setup, spray);\n' +
    '  const end = path[path.length - 1];\n' +
    '  const keeper = keeperDive(aim, setup, rng);\n' +
    '\n' +
    "  /* Under the wall's height and through its span is blocked. The wall is only\n" +
    "     a factor while the ball is still low and still over the wall's ground. */\n" +
    '  const span = wallSpan(setup);\n' +
    '  const overWallAt = path[Math.round(path.length * 0.45)];\n' +
    '  const hitWall = !!span && overWallAt.y < 0.38 && overWallAt.x > span.lo && overWallAt.x < span.hi;\n' +
    '\n' +
    '  const insideX = Math.abs(end.x) < 1;\n' +
    '  const insideY = end.y > 0 && end.y < 1;\n' +
    '  const hitPost = !hitWall && Math.abs(Math.abs(end.x) - 1) < 0.035 && insideY;\n' +
    '  const tooWeak = aim.power < 0.34 + (setup.distance - 11) * 0.012;\n' +
    '  const onTarget = !hitWall && !hitPost && insideX && insideY && !tooWeak;\n' +
    '\n' +
    '  /* The keeper saves what he can reach: a dive is a reach, not a teleport. */\n' +
    '  const reach = 0.34 + setup.keeperSkill * 0.2;\n' +
    '  const dx = Math.abs(end.x - keeper.x);\n' +
    '  const dy = Math.abs(end.y - keeper.y);\n' +
    '  const saved = onTarget && dx < reach && dy < reach + 0.25;\n' +
    '\n' +
    '  const scored = onTarget && !saved;\n' +
    '\n' +
    '  /* Points reward the hard shot, not the safe one: distance, the wall you beat\n' +
    '     and the corner you found all pay. A tap into the middle is worth least. */\n' +
    '  let points = 0;\n' +
    '  if (scored) {\n' +
    '    const corner = Math.max(Math.abs(end.x), end.y > 0.5 ? end.y : 0);\n' +
    '    points = Math.round(\n' +
    '      100 +\n' +
    '      (setup.distance - 11) * 6 +\n' +
    '      setup.wallSize * 15 +\n' +
    '      corner * 120 +\n' +
    '      setup.keeperSkill * 60,\n' +
    '    );\n' +
    '  }\n' +
    '\n' +
    '  const verdict = hitWall\n' +
    "    ? 'Into the wall.'\n" +
    '    : hitPost\n' +
    "    ? 'Off the post.'\n" +
    '    : tooWeak\n' +
    "    ? 'Never had the legs.'\n" +
    '    : !insideX || !insideY\n' +
    "    ? 'Wide of everything.'\n" +
    '    : saved\n' +
    "    ? 'Keeper got there.'\n" +
    "    : 'In the net.';\n" +
    '\n' +
    '  return { x: end.x, y: end.y, onTarget, saved, scored, hitPost, hitWall, points, keeperX: keeper.x, keeperY: keeper.y, path, verdict };\n' +
    '}\n' +
    '\n' +
    '/** The best a run can pay, for the honest "you scored N of M" line. */\n' +
    'export function maxRunScore(kicks: KickSetup[]): number {\n' +
    '  return kicks.reduce(\n' +
    '    (n, k) => n + Math.round(100 + (k.distance - 11) * 6 + k.wallSize * 15 + 120 + k.keeperSkill * 60),\n' +
    '    0,\n' +
    '  );\n' +
    '}\n' +
    '\n',
  operator: 'strictEqual',
  diff: 'simple'
}

