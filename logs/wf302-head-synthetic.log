-name: Lane remote check
-
-# A builder's own checks, run on a GitHub runner instead of the owner's PC. It runs ONLY for branches named rc/<name>:
-# a throwaway commit (the branch head plus .rc/request.txt, .rc/run.sh and this file) pushed by rc.sh in the lane's kit.
-# The results come back as the branch rc-results/<name> (summary.txt plus one log per command). Nothing here ever
-# reaches main: the request commit is never merged.
-on:
-  push:
-    branches: ['rc/**']
-
-permissions:
-  contents: write
-
-concurrency:
-  group: rc-${{ github.ref_name }}
-  cancel-in-progress: true
-
-jobs:
-  check:
-    runs-on: ubuntu-latest
-    timeout-minutes: 100
-    defaults:
-      run:
-        shell: bash
-    env:
-      SIM_NETWORK: offline
-      ENGINES: chromium
-      RC_REF: ${{ github.ref_name }}
-      GH_TOKEN: ${{ github.token }}
-    steps:
-      - uses: actions/checkout@v4
-        with:
-          fetch-depth: 0
-      - uses: actions/setup-node@v4
-        with:
-          node-version: 24
-          cache: npm
-      - name: Production is off limits
-        run: echo "127.0.0.1 flawuiqbvjobmkfkauhw.supabase.co" | sudo tee -a /etc/hosts
-      - name: Install
-        run: |
-          npm ci
-          if grep -q '^#!playwright' .rc/request.txt; then
-            npm install --no-save playwright
-            npx playwright install --with-deps chromium
-          fi
-      - name: Run the request
-        run: bash .rc/run.sh
-      - name: Publish the results
-        if: always()
-        run: |
-          OUT="$RUNNER_TEMP/rc-out"
-          mkdir -p "$OUT/logs"
-          [ -s "$OUT/summary.txt" ] || echo "SETUP exit=1 0s | the job stopped before any command ran (install or checkout failed)" > "$OUT/summary.txt"
-          NAME="${RC_REF#rc/}"
-          cd "$OUT"
-          git init -q
-          git config user.name "lane-remote-check"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add -A
-          git commit -q -m "rc results for $GITHUB_SHA"
-          git push -q -f "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "HEAD:refs/heads/rc-results/$NAME"
