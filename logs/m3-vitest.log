[22m[39mTICKET_HELP_BINDINGS|{"engineBefore":{"policy":"premium","crowd":67,"seats":120,"supporters":90,"gatePerSec":4.1875,"concessionsPerSec":0,"otherPerSec":0,"totalPerSec":4.1875,"growthPerSec":0.037500000000000006,"tap":3},"normal":{"paragraph":"The Ticket offer tile sets your matchday price, and switching is free at any time. Standard is the regular game. Community takes 15% off the gate money each fan pays and your supporters grow 50% faster. Premium adds 25% to the gate money each fan pays, but only 75% of your supporters turn up and they grow 25% slower. Only the ticket price moves: snacks, the shop, parking and the payroll keep their own rates. Example: a new 120 seat ground with 90 supporters draws 67 on Premium, so Premium pays less there, and it pays more once 75% of your supporters still fill the ground. Selling up puts the offer back to Standard.","sentence":"Premium adds 25% to the gate money each fan pays, but only 75% of your supporters turn up and they grow 25% slower.","values":[25,75,25]},"distinctTerms":{"id":"premium","label":"Premium","gate":1.25,"demand":0.75,"growth":0.6},"fixturePercentages":[25,75,40],"engineAfter":{"policy":"premium","crowd":67,"seats":120,"supporters":90,"gatePerSec":4.1875,"concessionsPerSec":0,"otherPerSec":0,"totalPerSec":4.1875,"growthPerSec":0.037500000000000006,"tap":3},"distinct":{"paragraph":"The Ticket offer tile sets your matchday price, and switching is free at any time. Standard is the regular game. Community takes 15% off the gate money each fan pays and your supporters grow 50% faster. Premium adds 25% to the gate money each fan pays, but only 75% of your supporters turn up and they grow 40% slower. Only the ticket price moves: snacks, the shop, parking and the payroll keep their own rates. Example: a new 120 seat ground with 90 supporters draws 67 on Premium, so Premium pays less there, and it pays more once 75% of your supporters still fill the ground. Selling up puts the offer back to Standard.","sentence":"Premium adds 25% to the gate money each fan pays, but only 75% of your supporters turn up and they grow 40% slower.","values":[25,75,40]},"restoredTerms":{"id":"premium","label":"Premium","gate":1.25,"demand":0.75,"growth":0.75}}

