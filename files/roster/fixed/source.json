    "file": "src/test/clubDetailOwnClub.test.tsx",
    "spans": [
      {
        "anchor": "/* Release AZ fix pass 4, the lead's ruling of 2026-10-12: the manager's own club is read from his squad, never\n   the world roster. The club screen opened on my own club (from a cup bracket, the Champions League cards or the\n   world tables) read it off the world roster minus my squad, so \"your club\" listed only the men of my club who\n   are not in my squad: the men a deep club's bake holds beyond the 26 a squad starts with. In a career that plays\n   the living world it now lists my squad, as a club I founded always did. A career from before the release (no\n   world seed, so by ruling Y1 no ledger either) reads the projected world here exactly as it did. Every state\n   below is the real engine's on a real club; nothing is made up. */",
        "replacement": "/* Club details use the saved owned squad for every career, including legacy\n   saves. Rival clubs still use their current world roster. */",
        "offset": 310
      },
      {
        "anchor": "a career from before the release reads its own club off the projected world exactly as it did",
        "replacement": "a career from before the release reads its own club from its current saved squad",
        "offset": 2873
      },
      {
        "anchor": "expect(screenText(old, 'Real Madrid')).toContain(`Squad (${projected.length} on the books)`);",
        "replacement": "expect(screenText(old, 'Real Madrid')).toContain(`Squad (${old.squad.length} on the books)`);",
        "offset": 3313
      },
      {
        "anchor": "    delete old.worldSeed;\n    expect(old.worldRoster).toBeUndefined();",
        "replacement": "    delete old.worldSeed;\n    /* Round 1344: a new career now carries its opening window's deals between other clubs in a ledger (the post\n       seed flush); a career from before the release had none, so it comes off with the seed. */\n    delete old.worldRoster;\n    expect(old.worldRoster).toBeUndefined();",
        "offset": 3076
      }
    ],
