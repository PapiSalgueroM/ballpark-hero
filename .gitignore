# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Never commit env files; the live Supabase URL and key are hardcoded in
# src/integrations/supabase/client.ts on purpose (see CLAUDE.md).
.env
.env.*

# Claude account migration packet, contains project IDs and account emails. Never commit.
_claude-migration/

# old session briefs and scratch scripts stay out of the public repo
docs/NEXT_SESSION_BRIEF.md
docs/scripts/build-connections-puzzles.py

# Claude Code agent worktrees: scratch checkouts, never repo content
.claude/worktrees/

# Codex worktrees: isolated feature checkouts, never repo content
/.worktrees/

# Round 404: nflverse season roster files downloaded by scripts/lib/nflverseRosters.mjs, never committed
scripts/.cache/

# Round 435: patched source copies simRebuildEconomy.mjs writes for its negative controls, deleted the moment the bundle exists
/.sim-control/

# Deliberately broken copies of a real hook, written by a harness for its
# negative control and deleted on exit (simTycoonAway, simDailyRecord). They
# are never repo content, and one committed by accident would ship the very
# defect its harness exists to catch.
src/hooks/__control_*.ts
# Round 505: the same for the Club Manager engine copies simLiveMatch and
# simTacticsEngine write (they live under .sim-control now, this is the belt).
src/lib/__control_*.ts
.dyad/

# Cowork era and tooling debris, 2026-09-12. CLAUDE.md has said since Round 133
# that none of this is repo content, but nothing stopped it: a single
# `git add -A` swept 1000 of these files into a merge commit on 2026-09-12 and
# it had to be unpicked by hand. Ignored so the accident cannot repeat.
/_bat_backup_*/
/_to_delete/
/ship_log*.txt
/_commit_msg_*.txt
/ROUND*_FILES.zip
/RUN*.bat
/SHIP*.bat
/tmp/
*.tsbuildinfo
# Snapshot dumps written by the Playwright MCP server while driving the site.
/.playwright-mcp/
# Other tools' local config, theirs to manage and never ours to commit.
/.agents/
/.codex/
/.claude/launch.json
